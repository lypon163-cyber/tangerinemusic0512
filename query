<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>成绩查询 | 柑橘音乐 Tangerine Music</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;600&display=swap" rel="stylesheet">
    <style>
        :root { --orange: #ff512f; --dark: #1a1a1a; }
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #ff8c00, #ff512f);
            margin: 0; min-height: 100vh;
            display: flex; align-items: center; justify-content: center;
        }
        .query-card {
            background: white; width: 90%; max-width: 500px;
            padding: 40px; border-radius: 30px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            text-align: center;
        }
        h2 { color: var(--dark); margin-bottom: 10px; }
        p { color: #666; font-size: 14px; margin-bottom: 30px; }
        
        .input-group { margin-bottom: 20px; text-align: left; }
        label { display: block; margin-bottom: 8px; font-weight: 500; color: #444; }
        input {
            width: 100%; padding: 12px; border: 1px solid #ddd;
            border-radius: 12px; outline: none; transition: 0.3s;
            box-sizing: border-box;
        }
        input:focus { border-color: var(--orange); box-shadow: 0 0 8px rgba(255,81,47,0.1); }
        
        .btn-query {
            width: 100%; padding: 15px; border: none;
            background: linear-gradient(135deg, #ff8c00, #ff512f);
            color: white; border-radius: 12px; font-weight: 600;
            cursor: pointer; transition: 0.3s; margin-top: 10px;
        }
        .btn-query:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(255,81,47,0.3); }

        /* 结果展示区 */
        #result-box {
            margin-top: 30px; padding-top: 20px;
            border-top: 1px dashed #eee; display: none;
        }
        .res-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
        .res-item span { display: block; font-size: 12px; color: #888; margin-bottom: 5px; }
        .res-item b { font-size: 20px; color: var(--orange); }

        .back-link { display: inline-block; margin-top: 25px; color: #aaa; text-decoration: none; font-size: 13px; }
    </style>
</head>
<body>

<div class="query-card">
    <h2>初试成绩查询</h2>
    <p>Result Inquiry System</p>

    <div class="input-group">
        <label>考生姓名</label>
        <input type="text" id="name" placeholder="请输入姓名">
    </div>
    <div class="input-group">
        <label>学号 / 准考证号</label>
        <input type="text" id="stu_id" placeholder="请输入学号">
    </div>

    <button class="btn-query" onclick="doQuery()">立即查询</button>

    <div id="result-box">
        <div class="res-grid">
            <div class="res-item"><span>成绩</span><b id="score">-</b></div>
            <div class="res-item"><span>排名</span><b id="rank">-</b></div>
            <div class="res-item"><span>状态</span><b id="status">-</b></div>
        </div>
    </div>

    <p id="error-msg" style="display:none; color: #ff512f; margin-top: 20px; font-size: 14px;">未找到匹配信息，请核对后重试。</p>

    <a href="index.html" class="back-link">← 返回主页</a>
</div>

<script>
    async function doQuery() {
        const name = document.getElementById('name').value.trim();
        const id = document.getElementById('stu_id').value.trim();
        const resBox = document.getElementById('result-box');
        const errMsg = document.getElementById('error-msg');
        
        if(!name || !id) { alert("请填写完整信息"); return; }

        // 对接你的 SheetDB
        const api = `https://sheetdb.io/api/v1/4x2oeeuemtkwp/search?name=${name}&id=${id}`;

        try {
            const response = await fetch(api);
            const data = await response.json();

            if(data && data.length > 0) {
                document.getElementById('score').innerText = data[0].score;
                document.getElementById('rank').innerText = data[0].rank;
                document.getElementById('status').innerText = data[0].status;
                resBox.style.display = 'block';
                errMsg.style.display = 'none';
            } else {
                resBox.style.display = 'none';
                errMsg.style.display = 'block';
            }
        } catch (e) {
            alert("网络繁忙");
        }
    }
</script>

</body>
</html>
