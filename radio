<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>柑橘电台 | Tangerine Radio</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;600&display=swap" rel="stylesheet">
    
    <style>
        :root { --orange: #ff512f; --dark: #1a1a1a; }
        body { margin: 0; font-family: 'Poppins', sans-serif; background: var(--dark); color: white; display: flex; flex-direction: column; align-items: center; min-height: 100vh; }
        .header { padding: 40px 0; text-align: center; }
        .header h1 { font-size: 2.5rem; margin: 0; background: linear-gradient(to right, #ff8c00, #ff512f); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        
        @keyframes rotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        .player-container { width: 95%; max-width: 900px; background: #222; padding: 30px; border-radius: 30px; box-shadow: 0 20px 50px rgba(0,0,0,0.5); display: flex; flex-wrap: wrap; gap: 30px; align-items: center; justify-content: center; }
        
        .vinyl-record { width: 180px; height: 180px; background: url('https://image.freepik.com/free-vector/black-vinyl-record-isolated-white-background_1217-1011.jpg') center/cover; border-radius: 50%; position: relative; animation: rotate 5s linear infinite; box-shadow: 0 0 20px rgba(0,0,0,0.8); }
        .vinyl-record::after { content: ""; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 50px; height: 50px; background: var(--orange); border-radius: 50%; border: 4px solid #000; }

        .playlist { flex: 1; min-width: 300px; max-height: 400px; overflow-y: auto; padding-right: 10px; }
        /* 滚动条美化 */
        .playlist::-webkit-scrollbar { width: 5px; }
        .playlist::-webkit-scrollbar-thumb { background: #444; border-radius: 10px; }

        .track-item { background: #333; margin-bottom: 12px; padding: 15px; border-radius: 15px; display: flex; align-items: center; cursor: pointer; transition: 0.3s; border-left: 5px solid transparent; }
        .track-item:hover { background: #444; transform: translateX(8px); border-left-color: var(--orange); }
        .track-item.active { background: #444; border-left-color: var(--orange); box-shadow: 0 5px 15px rgba(255, 81, 47, 0.2); }

        .track-tag { font-size: 10px; background: var(--orange); padding: 2px 6px; border-radius: 4px; margin-left: 10px; text-transform: uppercase; }
        .tag-demo { background: #666; }

        .track-info { margin-left: 15px; flex: 1; }
        .track-name { font-weight: 600; font-size: 15px; color: #eee; }
        .track-artist { font-size: 12px; color: #888; margin-top: 2px; }

        .player-footer { margin-top: 40px; width: 100%; max-width: 900px; background: white; border-radius: 20px; overflow: hidden; height: 86px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); }
        .back-home { margin: 40px 0; color: #666; text-decoration: none; font-size: 14px; transition: 0.3s; }
        .back-home:hover { color: var(--orange); }
    </style>
</head>
<body>

    <div class="header">
        <h1>Tangerine Radio</h1>
        <p>成品与灵感的碰撞</p>
    </div>

    <div class="player-container">
        <div class="vinyl-record" id="record"></div>

        <div class="playlist">
            <div class="track-item active" onclick="playSong('https://music.163.com/outchain/player?type=2&id=2165911052&auto=1&height=66')">
                <span>01</span>
                <div class="track-info">
                    <div class="track-name">Higher Ground<span class="track-tag">成品</span></div>
                    <div class="track-artist">Red Hot Chili Peppers (Your Pick)</div>
                </div>
            </div>

            <div class="track-item" onclick="alert('Demo 文件 [Higher Ground.aif] 已由管理员收录，由于外链限制，请点击成品试听~')">
                <span>02</span>
                <div class="track-info">
                    <div class="track-name">Higher Ground<span class="track-tag tag-demo">Demo.aif</span></div>
                    <div class="track-artist">原始小样录音</div>
                </div>
            </div>

            <div class="track-item" onclick="playSong('https://music.163.com/outchain/player?type=2&id=2050761286&auto=1&height=66')">
                <span>03</span>
                <div class="track-info">
                    <div class="track-name">GENIUS AND COWARDS<span class="track-tag">成品</span></div>
                    <div class="track-artist">The Birthday (Your Pick)</div>
                </div>
            </div>

            <div class="track-item" onclick="alert('Demo 文件 [GENIUS AND COWARDS.mp3] 已由管理员收录，由于外链限制，请点击成品试听~')">
                <span>04</span>
                <div class="track-info">
                    <div class="track-name">GENIUS AND COWARDS<span class="track-tag tag-demo">Demo.mp3</span></div>
                    <div class="track-artist">原始小样录音</div>
                </div>
            </div>
        </div>
    </div>

    <div class="player-footer">
        <iframe id="music-frame" frameborder="no" border="0" marginwidth="0" marginheight="0" width="100%" height="86" src="https://music.163.com/outchain/player?type=2&id=2165911052&auto=0&height=66"></iframe>
    </div>

    <a href="index.html" class="back-home">← Back to Home</a>

    <script>
        function playSong(url) {
            document.getElementById('music-frame').src = url;
            const items = document.querySelectorAll('.track-item');
            items.forEach(item => item.classList.remove('active'));
            event.currentTarget.classList.add('active');
            
            const record = document.getElementById('record');
            record.style.animation = 'none';
            setTimeout(() => { record.style.animation = 'rotate 5s linear infinite'; }, 10);
        }
    </script>
</body>
</html>
