<script>
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    
    // 严格匹配你目前根目录的文件名
    const samples = [
        'Kick.wav', 'Snare.wav', 'Clap.wav', 'Hat .wav', 'Close Hihat.wav',
        'LOOP—BASS A.wav', 'LOOP—CHORD A.wav', 'LOOP—MAINLEAD A.wav'
    ];
    
    const buffers = {};
    let isPlaying = false;
    let currentStep = 0;
    let nextStepTime = 0;
    const bpm = 160;
    const secondsPerStep = (60.0 / bpm) / 8; // 32步进逻辑

    async function loadSamples() {
        console.log("正在从根目录载入采样...");
        for (const file of samples) {
            try {
                // 注意：路径改成了当前目录 ./
                const response = await fetch(`./${encodeURIComponent(file)}`);
                const arrayBuffer = await response.arrayBuffer();
                buffers[file] = await audioCtx.decodeAudioData(arrayBuffer);
            } catch (e) {
                console.error("加载失败，请检查文件名:", file);
            }
        }
        document.getElementById('playBtn').innerText = 'START ENGINE';
    }

    // 初始化 8行 x 32列 的网格
    const grid = document.getElementById('grid');
    const rows = samples.length;
    const cols = 32;

    for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
            const step = document.createElement('div');
            step.classList.add('step');
            step.dataset.row = r;
            step.dataset.col = c;
            // 增加点击反馈
            step.addEventListener('mousedown', () => step.classList.toggle('active'));
            grid.appendChild(step);
        }
    }

    function playStep() {
        const steps = document.querySelectorAll('.step');
        steps.forEach(s => {
            const stepCol = parseInt(s.dataset.col);
            const stepRow = parseInt(s.dataset.row);
            
            if (stepCol === (currentStep + 31) % 32) s.classList.remove('playing');
            
            if (stepCol === currentStep) {
                s.classList.add('playing');
                if (s.classList.contains('active') && buffers[samples[stepRow]]) {
                    const source = audioCtx.createBufferSource();
                    source.buffer = buffers[samples[stepRow]];
                    source.connect(audioCtx.destination);
                    source.start(nextStepTime);
                }
            }
        });
        currentStep = (currentStep + 1) % 32;
    }

    function scheduler() {
        while (nextStepTime < audioCtx.currentTime + 0.1) {
            playStep();
            nextStepTime += secondsPerStep;
        }
        if (isPlaying) requestAnimationFrame(scheduler);
    }

    document.getElementById('playBtn').addEventListener('click', async () => {
        if (audioCtx.state === 'suspended') await audioCtx.resume();
        if (!isPlaying) {
            isPlaying = true;
            nextStepTime = audioCtx.currentTime;
            currentStep = 0;
            scheduler();
            document.getElementById('playBtn').innerText = 'STOP';
        } else {
            isPlaying = false;
            document.getElementById('playBtn').innerText = 'START';
        }
    });

    loadSamples();
</script>
